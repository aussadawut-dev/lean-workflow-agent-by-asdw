.DS_Store
.env
.env.*
!.env.example

# Claude local state
.claude/settings.local.json
# 4.x gate cache, left behind after the move to .agent-runtime/ in 5.0
.claude/.gate-cache

# Merge and patch debris, which --untracked would otherwise scan
*.orig
*.rej

# Behavior eval transcripts and reports (evals/run_evals.py)
evals/results/

# Local workflow state (contracts, gate cache, receipts, leases, progress, spawn worktrees) and Python caches
.agent-runtime/
__pycache__/
*.pyc

# v4 reference snapshot during the v5 rebuild (TCK001)
.temp/
