#!/usr/bin/env python3
"""Lean Workflow command line. Run `python3 .lean/bin/lean --help`."""
import json
import os
import re
import shlex
import stat
import sys
from pathlib import Path


def use_private_bytecode_cache():
    """Keep the checkout free of __pycache__ but compile the package once per user, not once per call.

    Bytecode goes to a per-user directory only when it is our own and closed to others (a shared directory
    such as /tmp would let another user plant code we then run). An explicit pycache prefix is respected;
    when no safe directory exists, nothing is written anywhere."""
    if sys.pycache_prefix:
        return
    try:
        base = os.environ.get("XDG_CACHE_HOME", "")
        base = base if os.path.isabs(base) else os.path.join(os.path.expanduser("~"), ".cache")
        chain = [base, os.path.join(base, "lean-workflow"), os.path.join(base, "lean-workflow", "pycache")]
        os.makedirs(base, mode=0o700, exist_ok=True)
        for folder in chain[1:]:
            try:
                os.mkdir(folder, 0o700)
            except FileExistsError:
                pass

        def private(folder):  # lstat: a symlink planted anywhere on the chain is refused, not followed.
            info = os.lstat(folder)
            return stat.S_ISDIR(info.st_mode) and info.st_uid == os.geteuid() and not info.st_mode & 0o022

        # Every directory from the base down: one another user can write to would let them swap what is below.
        if all(private(folder) for folder in chain):
            sys.pycache_prefix = chain[-1]
            return
    except (OSError, RuntimeError, KeyError):
        pass
    sys.dont_write_bytecode = True


use_private_bytecode_cache()
HOME = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(HOME))
# Tools that cannot write; while the package cannot load, they and repairs of the package still run.
READ_ONLY = {"Read", "Glob", "Grep", "LS", "NotebookRead", "WebFetch", "WebSearch", "ToolSearch", "Skill",
             "AskUserQuestion", "TodoWrite", "Agent", "Task", "SendMessage", "ListAgents", "update_plan",
             "view_image", "web_search", "request_user_input"}
REPAIRABLE = re.compile(r"(?:.*/)?\.lean/(?:lean(?:/[\w.-]*)?|bin/lean)")


def hook_event(argv):
    """(root, provider, event) for a `[--root R] hook <provider> <event>` call, else None."""
    root = HOME.parent
    if argv[:1] == ["--root"] and len(argv) > 1:
        root, argv = Path(argv[1]).resolve(), argv[2:]
    if len(argv) >= 3 and argv[0] == "hook" and argv[1] in ("claude", "codex"):
        return root, argv[1], argv[2]
    return None


def repairs_package(payload):
    """While the package cannot load: reads, and edits or Git restores of the package itself."""
    name = payload.get("tool_name")
    tool_input = payload.get("tool_input") if isinstance(payload.get("tool_input"), dict) else {}
    if name in READ_ONLY or (isinstance(name, str) and name.startswith("collaboration")):
        return True
    if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
        return bool(REPAIRABLE.fullmatch(str(tool_input.get("file_path", ""))))
    command = tool_input.get("command")
    if not isinstance(command, str):
        return False
    if name == "apply_patch":
        files = [line.split(":", 1)[1].strip() for line in command.splitlines() if line.startswith("*** ") and "File:" in line]
        return bool(files) and all(REPAIRABLE.fullmatch(path) for path in files)
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    return (words[:2] in (["git", "checkout"], ["git", "restore"]) and len(words) > 2
            and all(word in ("--", "--staged") or REPAIRABLE.fullmatch(word) for word in words[2:]))


def fallback(provider, event, stdin, error):
    """The answer when the package cannot load: fail closed, but keep it repairable."""
    message = (f"Lean CLI cannot load ({error!r}); only reads and repairs of .lean/lean/ are allowed. "
               "Restore it with `git checkout -- .lean/lean .lean/bin/lean`.")
    if event == "prompt":
        print(message, file=sys.stderr)
        return 1  # Warn without discarding the person's prompt.
    if event == "pre-tool":
        try:
            payload = json.loads(stdin)
        except ValueError:
            payload = {}
        if isinstance(payload, dict) and repairs_package(payload):
            return 0
        print(message, file=sys.stderr)
        return 2
    if event == "stop":
        try:
            continued = json.loads(stdin).get("stop_hook_active") is True
        except (ValueError, AttributeError):
            continued = False
        if continued:  # Blocking again would loop when the committed content itself cannot load.
            print(json.dumps({"systemMessage": message + " Stop released UNVERIFIED; validation NOT_RUN. "
                                              "The work is not DONE."}))
        else:
            print(json.dumps({"decision": "block", "reason": message + " Validation NOT_RUN; do not declare DONE."}))
        return 0
    print(message, file=sys.stderr)
    return 2


def main():
    argv = sys.argv[1:]
    hooked = hook_event(argv)
    if hooked is None:
        from lean.cli import main as cli
        return cli(argv)
    root, provider, event = hooked
    stdin = sys.stdin.read() if not sys.stdin.isatty() else ""
    try:
        if event in ("pre-tool", "prompt"):
            from lean import guard  # Only the guard: a broken unrelated module must not block every tool.
            code, message = guard.hook(root, event, stdin)
            if message:
                print(message, file=sys.stderr)
            return code
        from lean import hooks
        code, out, err = hooks.run_hook(root, provider, event, stdin, "--cache-tree" in argv)
    except Exception as error:  # noqa: BLE001 - a hook that cannot run must fail closed, not crash open.
        return fallback(provider, event, stdin, error)
    if out:
        print(out)
    if err:
        print(err, file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
