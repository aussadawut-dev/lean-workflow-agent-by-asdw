{
  "schema": 1,
  "checked": "2026-10-27",
  "max_agents": 1,
  "default_provider": "claude",
  "providers": {
    "claude": {
      "command": "claude",
      "args": ["-p", "{prompt}", "--model", "{model}", "--effort", "{effort}", "--permission-mode", "acceptEdits", "--output-format", "json"],
      "trusted_args": ["--permission-mode", "bypassPermissions"],
      "tiers": {
        "3S": {"model": "claude-haiku-5-5", "effort": "low"},
        "2S": {"model": "claude-haiku-5-5", "effort": "medium"},
        "S": {"model": "claude-sonnet-5-5", "effort": "low"},
        "M": {"model": "claude-sonnet-5-5", "effort": "medium"},
        "L": {"model": "claude-opus-5-5", "effort": "high"},
        "XL": {"model": "claude-opus-5-5", "effort": "xhigh"},
        "2XL": {"model": "claude-fable-5-1", "effort": "high"},
        "3XL": {"model": "claude-fable-5-1", "effort": "max"}
      }
    },
    "codex": {
      "command": "codex",
      "args": ["exec", "-m", "{model}", "-c", "model_reasoning_effort={effort}", "--sandbox", "workspace-write", "{prompt}"],
      "trusted_args": [],
      "tiers": {
        "3S": {"model": "gpt-6-luna", "effort": "low"},
        "2S": {"model": "gpt-6.1-terra", "effort": "low"},
        "S": {"model": "gpt-6.1-terra", "effort": "medium"},
        "M": {"model": "gpt-6.1-sol", "effort": "medium"},
        "L": {"model": "gpt-6.1-sol", "effort": "high"},
        "XL": {"model": "gpt-6-astra", "effort": "high"},
        "2XL": {"model": "gpt-6-astra", "effort": "xhigh"},
        "3XL": {"model": "gpt-6-astra", "effort": "max"}
      }
    },
    "agy": {
      "command": "agy",
      "args": ["-p", "{prompt}", "--model", "{model}", "--output-format", "json", "--print-timeout", "{timeout}s"],
      "trusted_args": ["--dangerously-skip-permissions"],
      "tiers": {
        "3S": {"model": "gemini-3.8-flash-low", "effort": null},
        "2S": {"model": "gemini-3.8-flash-medium", "effort": null},
        "S": {"model": "gemini-3.8-flash-high", "effort": null},
        "M": {"model": "gemini-4-argon-low", "effort": null},
        "L": {"model": "gemini-4-argon-medium", "effort": null},
        "XL": {"model": "gemini-4-argon-high", "effort": null},
        "2XL": {"model": "gemini-4-argon-high", "effort": null},
        "3XL": {"model": "gemini-4-argon-high", "effort": null}
      }
    }
  }
}
