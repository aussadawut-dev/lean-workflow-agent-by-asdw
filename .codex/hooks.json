{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.lean/bin/lean\" hook codex session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.lean/bin/lean\" hook codex stop --cache-tree",
            "timeout": 600,
            "statusMessage": "Checking Lean Quality Gate policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.lean/bin/lean\" hook codex pre-tool || exit 2",
            "statusMessage": "Checking Lean Task Contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.lean/bin/lean\" hook codex prompt"
          }
        ]
      }
    ]
  }
}
