{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality_gate.py\" session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality_gate.py\" stop --cache-tree",
            "timeout": 600,
            "statusMessage": "Checking Lean Quality Gate policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)\"/.lean/scripts/contract_guard.py --root \"$(git rev-parse --show-toplevel)\" pre-tool || exit 2",
            "statusMessage": "Checking Lean Task Contract"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)\"/.lean/scripts/contract_guard.py --root \"$(git rev-parse --show-toplevel)\" prompt"
          }
        ]
      }
    ]
  }
}
