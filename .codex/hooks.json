{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality_gate.py\" session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/quality_gate.py\" stop",
            "timeout": 600,
            "statusMessage": "Checking Lean Quality Gate policy"
          }
        ]
      }
    ]
  }
}
